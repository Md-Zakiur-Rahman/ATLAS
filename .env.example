# Blue Team System Configuration

# Database
DATABASE_PATH=logs/events.db

# Authentication
FAILED_LOGIN_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# Monitoring
FILE_MONITOR_ENABLED=true
PROCESS_MONITOR_ENABLED=true
THREAT_RULES_ENABLED=true

# Alert Thresholds
ALERT_THRESHOLD_LOW=10
ALERT_THRESHOLD_MEDIUM=20
ALERT_THRESHOLD_HIGH=50

# Development
DEBUG_MODE=false
DEMO_MODE=false